# ==============================================================================
# GreenGuard - Security and Server Configuration
# Compatible with XAMPP Apache and InfinityFree Hosting
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Set default character encoding
AddDefaultCharset UTF-8

# Prevent direct access to sensitive file types (.json, .log, .ini, .example, .sql, .git)
<FilesMatch "\.(json|log|ini|example|sql|md|git|gitignore|gitkeep)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Allow access to index.php, assets, and standard public files
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
</IfModule>

# Security Headers (where supported)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
